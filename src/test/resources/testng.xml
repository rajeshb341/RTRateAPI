<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Automation Suite" verbose="1" parallel="none" preserve-order="true">
    <!--
        Single test data file: src/test/resources/testdata/test-data.xlsx (sheet TestData).
        It is only read by a run - results go to target/rater-output/Run_<timestamp>/.
        The older Excel-driven suites (MockContractTest, DataDrivenApiTest) are not part of this suite any more.

        One run, iteration by iteration (rater.iterations): the API call of iteration 1 (compared with the Rater), then -
        with ui.enabled=true in rater.properties - the UI flow of iteration 1 with the same test data, then iteration 2 ...
        Reports in the same Run_<timestamp> folder: RaterValidationReport (API vs Rater), UiValidationReport (API vs UI).
    -->
    <test name="Rater and UI Validation" preserve-order="true">
        <classes>
            <class name="com.automation.rater.RaterValidationTest"/>
        </classes>
    </test>
</suite>